# Copy to .env and replace placeholder secrets, or run scripts/Initialize-LocalEnv.ps1.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BITRO_HTTP_PORT=7075
BITRO_POSTGRES_PASSWORD=replace-with-random-secret
BITRO_DB_CONNECTION_STRING=Host=backend-postgres;Port=5432;Database=bitrolearn;Username=bitro;Password=replace-with-random-secret;Maximum Pool Size=30
BITRO_REDIS_PASSWORD=replace-with-random-secret
BITRO_REDIS_CONNECTION_STRING=backend-redis:6379,password=replace-with-random-secret,abortConnect=false,connectTimeout=3000,asyncTimeout=3000
BITRO_OPENAPI_ENABLED=true
BITRO_SUPERUSER_EMAIL=admin@bitrolearn.local
BITRO_SUPERUSER_PASSWORD=replace-with-strong-12-character-password
BITRO_ADMIN_MAX_ATTEMPTS=5
BITRO_ADMIN_LOCK_SECONDS=900
BITRO_OTP_HMAC_KEY=replace-with-at-least-32-random-characters
BITRO_OTP_TTL_SECONDS=120
BITRO_OTP_RESEND_SECONDS=60
BITRO_OTP_MAX_ATTEMPTS=5
BITRO_OTP_LOCK_SECONDS=900
BITRO_OTP_RATE_WINDOW_SECONDS=3600
BITRO_OTP_PHONE_HOURLY_LIMIT=5
BITRO_OTP_IP_HOURLY_LIMIT=20
BITRO_COOKIE_SECURE=false
BITRO_COOKIE_LIFETIME_HOURS=8
BITRO_DATA_PROTECTION_APPLICATION_NAME=BitroLearn.Backend
BITRO_CACHE_LOCAL_SECONDS=15
BITRO_CACHE_DISTRIBUTED_SECONDS=60
BITRO_CACHE_REDIS_CONNECTION_STRING=backend-cache:6379,password=replace-cache-password,abortConnect=false
BITRO_CACHE_REDIS_PASSWORD=replace-cache-password
BITRO_CACHE_FAILURE_BACKOFF_SECONDS=5
BITRO_LEARNING_CODE_MAX_BYTES=262144
BITRO_LEARNING_PROJECT_MAX_BYTES=1048576
BITRO_LEARNING_PROJECT_MAX_FILES=100
BITRO_S3_ENDPOINT=http://backend-seaweed:8333
BITRO_S3_ACCESS_KEY=replace-access-key
BITRO_S3_SECRET_KEY=replace-secret-key
BITRO_S3_BUCKET=bitrolearn
BITRO_S3_PUBLIC_ENDPOINT=http://localhost:7076
BITRO_MEDIA_LINK_TTL_SECONDS=14400
BITRO_ZIBAL_MERCHANT=zibal
BITRO_ZIBAL_CALLBACK_URL=http://localhost:7075/public/payments/zibal/callback
BITRO_APP_PUBLIC_URL=http://localhost:3000
BITRO_SPOTPLAYER_TEST=true
# BITRO_SPOTPLAYER_API_KEY is required for automatic license provisioning.
BITRO_TRUSTED_PROXY_NETWORK=172.21.0.0/16
